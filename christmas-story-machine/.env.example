# Set these in your environment (or your host's settings). Everything is optional.

# Claude writes captions and narration, plans text stories, and double-checks
# every submission is family-friendly. Without it, warm template captions and
# an offline story planner are used.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_VISION=0            # don't send downscaled photos/drawings to Claude for captions

# Record the narrator (Santa, a grandparent or a storyteller — the host picks)
# into the exported video. Otherwise the reveal screen reads the narration with
# the browser's built-in voice. ElevenLabs gives the most Santa-like result:
# pick a deep, jolly voice in their voice library and paste its id below.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_SANTA=
# ELEVENLABS_VOICE_GRANDPARENT=
# ELEVENLABS_VOICE_STORYTELLER=
# Or use OpenAI's speech voices, directed to perform each narrator:
OPENAI_API_KEY=
# TTS_VOICE=fable        # storyteller voice

# Illustrate long story slideshows with stock photos instead of built-in artwork.
PEXELS_API_KEY=

# Public address used in invite/share links, e.g. https://christmas.example.com
BASE_URL=
# Set to 1 (or true) when running behind a reverse proxy that terminates HTTPS.
TRUST_PROXY=
# Require a password to create new events (recommended on a public server).
CREATE_PASSWORD=

PORT=3000
DATA_DIR=./data
# RENDER_CONCURRENCY=3   # parallel video renders (default: CPU cores - 1, max 3)
# AI_CONCURRENCY=4       # parallel Claude calls
# MAX_UPLOAD_MB=40
# MAX_CONCURRENT_UPLOADS=24
